---
import "aos/dist/aos.css"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Sổ Trọ – Quản lý phòng trọ đơn giản & hiệu quả</title>
    <meta
      name="description"
      content="Sổ Trọ giúp chủ trọ quản lý phòng, hợp đồng, điện nước, và thu chi dễ dàng. Tiết kiệm thời gian, quản lý trọ thông minh, tiện lợi."
    />

    <link rel="icon" type="image/svg+xml" href="/logo.png" />
    <meta property="og:title" content="Sổ Trọ – Quản lý phòng trọ hiệu quả" />
    <meta
      property="og:description"
      content="Ứng dụng quản lý phòng trọ thông minh: theo dõi hợp đồng, tiền trọ, điện nước và thu chi."
    />
    <meta property="og:image" content="/logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sotro-4au.pages.dev/" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Sổ Trọ – Quản lý phòng trọ hiệu quả" />
    <meta
      name="twitter:description"
      content="Quản lý phòng trọ dễ dàng: hợp đồng, điện nước, thu chi."
    />
    <meta name="twitter:image" content="/logo.png" />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://sotro-4au.pages.dev/" />
    <meta name="generator" content={Astro.generator} />
    <title>Sổ trọ</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Sổ Trọ",
        "url": "https://sotro-4au.pages.dev/",
        "image": "https://sotro-4au.pages.dev/logo.png",
        "description": "Ứng dụng quản lý phòng trọ thông minh: hợp đồng, tiền trọ, điện nước, thu chi.",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "All",
        "creator": {
          "@type": "Organization",
          "name": "Sổ Trọ"
        }
      }
    </script>
  </head>
  <body class="font-sans">
    <slot />
    <script>
      import AOS from "aos"
      AOS.init({
        duration: 800,
        easing: "ease-in-out",
        once: true,
      })
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }
</style>
