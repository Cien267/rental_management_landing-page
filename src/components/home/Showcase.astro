<section class="py-20 pb-40 bg-linear-to-b from-accent-light/20 to-background">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 animate-slide-up">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-foreground">
          Đơn Giản, Tinh Tế, Chuyên Nghiệp
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Giao diện trực quan giúp bạn nắm bắt toàn bộ hoạt động kinh doanh cho
          thuê chỉ trong nháy mắt.
        </p>
      </div>

      <div class="relative animate-fade-in">
        <div
          class="absolute -inset-4 bg-linear-to-r from-accent/20 via-primary/20 to-accent/20 rounded-3xl blur-3xl opacity-50"
        >
        </div>
        <div
          class="relative rounded-2xl overflow-hidden shadow-[0_12px_24px_rgba(0,111,200,0.3)] border p-4 border-gray-200"
        >
          <img
            src="/src/assets/screenshot.webp"
            alt="So Tro dashboard showing tenant management, payment tracking, and room occupancy"
            class="w-full h-auto"
          />
        </div>
      </div>
    </div>
