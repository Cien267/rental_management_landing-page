---
import logo from "../../assets/logo.png"
import { Image } from "astro:assets"
---

<header
  class="fixed top-0 z-50 bg-background/95 backdrop-blur-md w-full border-b border-border border-gray-300 shadow-md"
>
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center md:block"
  >
    <div class="flex items-center justify-between">
      <div class="flex-shrink-0">
        <Image src={logo} alt="Logo Sổ Trọ" class="h-18 w-auto" />
      </div>

      <div class="hidden md:flex items-center space-x-12">
        <a
          href="#features"
          class="text-md font-medium text-foreground transition-colors hover:text-sky-600"
        >
          Tính năng
        </a>
        <a
          href="#pricing"
          class="text-md font-medium text-foreground transition-colors hover:text-sky-600"
        >
          Giá
        </a>
        <a
          href="#faq"
          class="text-md font-medium text-foreground transition-colors hover:text-sky-600"
        >
          FAQ
        </a>
      </div>

      <div class="hidden md:block">
        <a href="https://rental-management-fe.pages.dev" target="_blank"
          ><button
            type="submit"
            class="cursor-pointer flex justify-center gap-2 items-center mx-auto text-md bg-gray-50 hover:bg-sky-50 backdrop-blur-md lg:font-semibold isolation-auto border-gray-200 before:absolute before:w-full before:transition-all before:duration-700 before:hover:w-full before:-left-full before:hover:left-0 before:rounded-full before:bg-emerald-500 hover:text-sky-600 before:-z-10 before:aspect-square before:hover:scale-150 before:hover:duration-700 relative z-10 px-3 py-2 overflow-hidden border-2 rounded-full group"
          >
            Bắt đầu trải nghiệm ngay
            <svg
              class="w-8 h-8 justify-end group-hover:rotate-90 group-hover:bg-gray-50 text-gray-50 ease-linear duration-300 rounded-full border border-gray-700 group-hover:border-none p-2 rotate-45"
              viewBox="0 0 16 19"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M7 18C7 18.5523 7.44772 19 8 19C8.55228 19 9 18.5523 9 18H7ZM8.70711 0.292893C8.31658 -0.0976311 7.68342 -0.0976311 7.29289 0.292893L0.928932 6.65685C0.538408 7.04738 0.538408 7.68054 0.928932 8.07107C1.31946 8.46159 1.95262 8.46159 2.34315 8.07107L8 2.41421L13.6569 8.07107C14.0474 8.46159 14.6805 8.46159 15.0711 8.07107C15.4616 7.68054 15.4616 7.04738 15.0711 6.65685L8.70711 0.292893ZM9 18L9 1H7L7 18H9Z"
                class="fill-gray-800 group-hover:fill-sky-600"></path>
            </svg>
          </button></a
        >
      </div>

      <div class="md:hidden">
        <button
          class="inline-flex items-center justify-center p-2 rounded-md text-foreground hover:bg-secondary"
        >
        </button>
      </div>
    </div>

    <button
      type="submit"
      class="md:hidden cursor-pointer flex justify-center gap-2 items-center mx-auto text-md bg-gray-50 hover:bg-sky-50 backdrop-blur-md lg:font-semibold isolation-auto border-gray-200 before:absolute before:w-full before:transition-all before:duration-700 before:hover:w-full before:-left-full before:hover:left-0 before:rounded-full before:bg-emerald-500 hover:text-sky-600 before:-z-10 before:aspect-square before:hover:scale-150 before:hover:duration-700 relative z-10 px-3 py-2 overflow-hidden border-2 rounded-full group"
    >
      Bắt đầu trải nghiệm ngay
      <svg
        class="w-8 h-8 justify-end group-hover:rotate-90 group-hover:bg-gray-50 text-gray-50 ease-linear duration-300 rounded-full border border-gray-700 group-hover:border-none p-2 rotate-45"
        viewBox="0 0 16 19"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M7 18C7 18.5523 7.44772 19 8 19C8.55228 19 9 18.5523 9 18H7ZM8.70711 0.292893C8.31658 -0.0976311 7.68342 -0.0976311 7.29289 0.292893L0.928932 6.65685C0.538408 7.04738 0.538408 7.68054 0.928932 8.07107C1.31946 8.46159 1.95262 8.46159 2.34315 8.07107L8 2.41421L13.6569 8.07107C14.0474 8.46159 14.6805 8.46159 15.0711 8.07107C15.4616 7.68054 15.4616 7.04738 15.0711 6.65685L8.70711 0.292893ZM9 18L9 1H7L7 18H9Z"
          class="fill-gray-800 group-hover:fill-sky-600"></path>
      </svg>
    </button>
  </nav>
</header>
